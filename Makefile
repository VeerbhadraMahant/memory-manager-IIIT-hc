.PHONY: install lock lint test db up down migrate run

PY ?= python3
VENV ?= .venv
BIN := $(VENV)/bin
TEST_DATABASE_URL ?= postgresql://nam:nam@127.0.0.1:5432/nam

install:
	$(PY) -m venv $(VENV) && $(BIN)/pip install -r backend/requirements-dev.txt

lock:  ## regenerate backend/requirements.lock from a clean venv
	rm -rf .lockvenv && $(PY) -m venv .lockvenv && .lockvenv/bin/pip install -q -r backend/requirements.txt
	(echo "# Generated by 'make lock' from requirements.txt. Do not edit."; .lockvenv/bin/pip freeze --exclude-editable | grep -vi '^pip==') > backend/requirements.lock
	rm -rf .lockvenv

lint:
	$(BIN)/ruff check backend

db:  ## disposable Postgres+pgvector for tests
	docker compose up -d db

test:
	cd backend && TEST_DATABASE_URL=$(TEST_DATABASE_URL) ../$(BIN)/python -m pytest -q

migrate:
	cd backend && ../$(BIN)/python scripts/migrate.py

run:
	cd backend && ../$(BIN)/python -m uvicorn app.main:app --reload --port 8000

up:
	docker compose up --build

down:
	docker compose down
