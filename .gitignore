# --- secrets: never commit ---
.env
.env.*
!.env.example

# Key material and service-account JSON. The LLM API key lives in .env today,
# but a downloaded service-account file is the usual way a Google credential ends up
# committed by accident.
*.pem
*.key
*.p12
*.pfx
*-service-account.json
service-account*.json
gcp-*.json


# --- database dumps ---
# NOT a blanket *.sql rule — backend/migrations/*.sql must stay tracked. These
# patterns target dump output specifically, which matters more here than in most
# projects: the demo database deliberately contains medication, health and family
# details. A dump committed to a public repo is a real disclosure, not just mess.
*.dump
*.sql.gz
*.sql.bz2
*.sql.zip
dump*.sql
*dump.sql
backup*.sql
*backup.sql
*.sqlite
*.sqlite3
*.db


# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/


# --- node / next.js ---
node_modules
.next/
out/
build/
dist/
*.tsbuildinfo
.npm/
.turbo/
.vercel
next-env.d.ts


# --- editors / os ---
# .claude/settings.json IS committed — it carries the Stop hook that maintains this
# file. Only the personal-override layer is ignored.
.claude/settings.local.json
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini


# --- logs, scratch, merge debris ---
*.log
npm-debug.log*
yarn-error.log*
tmp/
scratch/
*.orig
*.rej
*.bak

# --- working docs, kept out of the published repo ---
# These stay on disk and keep being maintained; they are just not part of what
# gets published. CLAUDE.md is unanchored so it also covers frontend/CLAUDE.md;
# the rest are anchored to the root so a future docs/PHASES.md is a fresh choice
# rather than something silently swallowed by a stale rule.
CLAUDE.md
/DECISION_LOG.md
/PHASES.md
/SYSTEM_DESIGN.md
/DESIGN_BRIEF.md


# -------miscellaneous--------
gemini_quickstarts.md