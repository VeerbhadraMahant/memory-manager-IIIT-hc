# Copy to .env for local development. .env is gitignored — never commit real values.
# In production do NOT use a .env file: supply secrets as files (NAME_FILE) or via your
# platform's secret store. See docs/DEPLOYMENT.md and docs/TEE.md.
#
# Every secret below also works as  NAME_FILE=/path/to/file  or  $SECRETS_DIR/<name>.

ENVIRONMENT=development          # development | test | production (production fails fast on unsafe config)

# ---------------------------------------------------------------- database
# Supabase → Connect. Direct connection if your network has IPv6, otherwise the Session
# pooler (username becomes postgres.<project-ref>). Append ?sslmode=require.
#   Direct:  postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#   Pooler:  postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# The *transaction* pooler (port 6543) also works if you set DB_DISABLE_PREPARED_STATEMENTS=true.
DATABASE_URL=
DB_DISABLE_PREPARED_STATEMENTS=false
DB_POOL_MAX=10

# ---------------------------------------------------------------- LLM providers
# https://openrouter.ai/keys — required: it also does extraction and embeddings.
LLM_API_KEY=
# Optional extra chat providers; whichever are set appear in the UI's model switcher.
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------- authentication
# false: every request acts as the shared demo user (local dev / hackathon demo).
# true : requests must carry a verified identity. Forced on in production.
AUTH_REQUIRED=false
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase Auth (recommended). Newer projects sign with asymmetric keys -> set SUPABASE_URL.
# Legacy projects sign with a shared secret -> set SUPABASE_JWT_SECRET (Project Settings -> API).
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Google Identity Services (alternative): the browser posts its ID token to POST /auth/google.
GOOGLE_CLIENT_ID=
# Signs the session token issued by /auth/google. `openssl rand -base64 48`
SESSION_SECRET=

# ---------------------------------------------------------------- web
# Comma-separated, exact origins. Never '*'.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Your API hostname(s); rejects other Host headers. Leave empty in dev.
TRUSTED_HOSTS=
APP_URL=http://localhost:3000
# Interactive docs at /docs. Default: on in dev, off in production.
# DOCS_ENABLED=true

# ---------------------------------------------------------------- confidential compute
# Refuse to boot unless a TEE guest interface (SEV-SNP / TDX / Nitro / dstack) is visible.
REQUIRE_TEE=false

# ---------------------------------------------------------------- operations
LOG_LEVEL=INFO
LOG_JSON=false
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_LLM_PER_MINUTE=30
# Chat / extraction / embedding models (OpenRouter slugs). `:free` slugs are retired
# without notice — drop the suffix if chat starts 404-ing.
# LLM_CHAT_MODEL=
# LLM_EXTRACT_MODEL=

# Frontend → backend origin (read by the Next.js app, not the API)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
