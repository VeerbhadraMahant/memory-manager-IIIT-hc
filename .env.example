# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase → Connect → Session pooler (or Direct connection if your network has IPv6).
# Direct:  postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
# Pooler:  postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Chat providers. At least one is required; whichever keys are present become options
# in the UI's model switcher (D32). Extraction and embeddings always run on OpenRouter
# regardless of which provider answers a turn — memory stays provider-independent.

# https://openrouter.ai/keys — also does extraction + embeddings, so effectively required.
# Chat and extraction default to `:free` model slugs; embeddings have no free option
# but cost fractions of a cent per demo. Override LLM_CHAT_MODEL / LLM_EXTRACT_MODEL
# to drop the `:free` suffix if the daily free-tier limit bites.
LLM_API_KEY=

# https://console.groq.com/keys — optional. Fast; default model is a reasoning model
# whose <think> traces are stripped in llm.py.
GROQ_API_KEY=

# https://aistudio.google.com/apikey — optional. Note gemini-2.5-flash is listed by the
# API but rejected for new keys; GEMINI_CHAT_MODEL defaults to a model that works.
GEMINI_API_KEY=

# Fixed demo user seeded by migration 002. No auth flow during the hackathon.
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# Frontend → backend origin
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
